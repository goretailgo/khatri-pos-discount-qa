<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_khatri_discount" model="ir.ui.view">
        <field name="name">pos.config.settings.khatri.discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_pricing_section']" position="inside">
                <setting string="Discount" help="Apply automatic stepped discount on all products">
                    <field name="pos_khatri_enable_stepped_discount"/>
                    <div class="content-group mt16" invisible="not pos_khatri_enable_stepped_discount">
                        <div class="row mt8">
                            <label for="pos_khatri_first_discount" class="col-lg-3 o_light_label"/>
                            <field name="pos_khatri_first_discount"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_khatri_enable_second_discount" class="col-lg-3 o_light_label" string="Enable Cascading Discount"/>
                            <field name="pos_khatri_enable_second_discount"/>
                        </div>
                        <div class="row mt8" invisible="not pos_khatri_enable_second_discount">
                            <label for="pos_khatri_second_discount" class="col-lg-3 o_light_label"/>
                            <field name="pos_khatri_second_discount"/>
                        </div>

                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
