<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.ReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('text-center')][span[hasclass('pos-receipt-vat')]]" position="replace">
            <div class="text-center pt-1" style="font-size: 75%;">
                <div t-if="order.date_order" id="order-date" t-out="order.formatDateOrTime('date_order')"/>
                <div t-if="order.pos_reference" style="font-weight:700;">Receipt: <t t-out="order.pos_reference"/></div>
                <div t-if="order.company and order.company.vat" style="font-weight:600; margin-top:2px;">GSTIN: <t t-out="order.company.vat"/></div>
            </div>
        </xpath>

    </t>

    <t t-name="point_of_sale.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <xpath expr="//div[div[hasclass('pos-config-name')]]" position="replace"/>

        <xpath expr="//OrderDisplay" position="before">
            <t t-set="khatriInfo" t-value="getKhatriOrderInfo()"/>
            <t t-set="steppedLines" t-value="khatriSteppedLines()"/>
            <t t-set="customLines" t-value="khatriCustomLines()"/>

            <!-- ============ SECTION A: 50% + 25% items ============ -->
            <t t-if="steppedLines.length">
                <div style="margin-top:6px; font-size:12px; font-weight:700; background:#f3e5f5; padding:3px 5px; border-radius:3px;">
                    <t t-esc="khatriSectionAHeading()"/>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:10px; font-weight:700; border-bottom:1px solid #999; padding:2px 0;">
                    <span style="width:16px;">#</span>
                    <span style="flex:1;">Item</span>
                    <span style="width:20px; text-align:center;">Qty</span>
                    <span style="width:58px; text-align:right;">Unit</span>
                    <span style="width:58px; text-align:right;">MRP</span>
                    <span style="width:58px; text-align:right;">Price</span>
                </div>
                <t t-foreach="steppedLines" t-as="sl" t-key="sl_index">
                    <div style="display:flex; justify-content:space-between; font-size:11px; padding:2px 0;">
                        <span style="width:16px;"><t t-esc="sl_index + 1"/></span>
                        <span style="flex:1;"><t t-esc="khatriLineName(sl)"/></span>
                        <span style="width:20px; text-align:center;"><t t-esc="sl.qty"/></span>
                        <span style="width:58px; text-align:right; color:#888;"><t t-esc="formatCurrency(khatriLineUnitMrp(sl))"/></span>
                        <t t-if="khatriLineHasDiscount(sl)">
                            <span style="width:58px; text-align:right; color:#888; text-decoration:line-through;"><t t-esc="formatCurrency(khatriLineMrpNum(sl))"/></span>
                        </t>
                        <t t-if="khatriLineNoDiscount(sl)">
                            <span style="width:58px; text-align:right; color:#888;"><t t-esc="formatCurrency(khatriLineMrpNum(sl))"/></span>
                        </t>
                        <span style="width:58px; text-align:right; font-weight:600;"><t t-esc="formatCurrency(khatriLineFinalNum(sl))"/></span>
                    </div>
                </t>
                <!-- Section A summary -->
                <div style="margin-top:3px; padding-top:3px; border-top:1px dashed #bbb;">
                    <div style="display:flex; justify-content:space-between; font-size:11px; color:#555;">
                        <span>MRP Total</span>
                        <t t-if="khatriInfo.steppedSaved > 0">
                            <span style="text-decoration:line-through;"><t t-esc="formatCurrency(khatriInfo.steppedOriginal)"/></span>
                        </t>
                        <t t-if="khatriInfo.steppedSaved == 0">
                            <span><t t-esc="formatCurrency(khatriInfo.steppedOriginal)"/></span>
                        </t>
                    </div>
                    <t t-if="khatriInfo.steppedSaved > 0">
                        <div style="display:flex; justify-content:space-between; font-size:11px; color:#c0392b;">
                            <span>Discount</span>
                            <span>- <t t-esc="formatCurrency(khatriInfo.steppedSaved)"/></span>
                        </div>
                    </t>
                    <div style="display:flex; justify-content:space-between; font-size:12px; font-weight:700; color:#1a1a1a; margin-top:2px;">
                        <span>Section A Total</span>
                        <span><t t-esc="formatCurrency(khatriInfo.steppedFinal)"/></span>
                    </div>
                </div>
            </t>

            <!-- ============ SECTION B: Special discount items ============ -->
            <t t-if="customLines.length">
                <div style="margin-top:10px; font-size:12px; font-weight:700; background:#fdecea; padding:3px 5px; border-radius:3px;">
                    <t t-if="khatriInfo.customSaved > 0">SECTION B : Special Discount</t>
                    <t t-if="khatriInfo.customSaved == 0">SECTION B</t>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:10px; font-weight:700; border-bottom:1px solid #999; padding:2px 0;">
                    <span style="width:16px;">#</span>
                    <span style="flex:1;">Item</span>
                    <span style="width:20px; text-align:center;">Qty</span>
                    <span style="width:58px; text-align:right;">Unit</span>
                    <span style="width:58px; text-align:right;">MRP</span>
                    <span style="width:58px; text-align:right;">Price</span>
                </div>
                <t t-foreach="customLines" t-as="cl" t-key="cl_index">
                    <div style="display:flex; justify-content:space-between; font-size:11px; padding:2px 0;">
                        <span style="width:16px;"><t t-esc="cl_index + 1"/></span>
                        <span style="flex:1;">
                            <t t-esc="khatriLineName(cl)"/>
                            <t t-if="khatriLinePct(cl)"><span style="color:#c0392b; font-weight:700;"> (<t t-esc="khatriLinePct(cl)"/>% off)</span></t>
                        </span>
                        <span style="width:20px; text-align:center;"><t t-esc="cl.qty"/></span>
                        <span style="width:58px; text-align:right; color:#888;"><t t-esc="formatCurrency(khatriLineUnitMrp(cl))"/></span>
                        <t t-if="khatriLineHasDiscount(cl)">
                            <span style="width:58px; text-align:right; color:#888; text-decoration:line-through;"><t t-esc="formatCurrency(khatriLineMrpNum(cl))"/></span>
                        </t>
                        <t t-if="khatriLineNoDiscount(cl)">
                            <span style="width:58px; text-align:right; color:#888;"><t t-esc="formatCurrency(khatriLineMrpNum(cl))"/></span>
                        </t>
                        <span style="width:58px; text-align:right; font-weight:600;"><t t-esc="formatCurrency(khatriLineFinalNum(cl))"/></span>
                    </div>
                </t>
                <!-- Section B summary -->
                <div style="margin-top:3px; padding-top:3px; border-top:1px dashed #bbb;">
                    <t t-if="khatriInfo.customSaved > 0">
                        <div style="display:flex; justify-content:space-between; font-size:11px; color:#555;">
                            <span>MRP Total</span>
                            <span style="text-decoration:line-through;"><t t-esc="formatCurrency(khatriInfo.customOriginal)"/></span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:11px; color:#c0392b;">
                            <span>Discount <t t-if="khatriInfo.customDiscountPct">(<t t-esc="khatriInfo.customDiscountPct"/>%)</t></span>
                            <span>- <t t-esc="formatCurrency(khatriInfo.customSaved)"/></span>
                        </div>
                    </t>
                    <div style="display:flex; justify-content:space-between; font-size:12px; font-weight:700; color:#1a1a1a; margin-top:2px;">
                        <span>Section B Total</span>
                        <span><t t-esc="formatCurrency(khatriInfo.customFinal)"/></span>
                    </div>
                </div>
            </t>
        </xpath>

        <!-- Hide the default Odoo line list to avoid duplicate display -->
        <xpath expr="//OrderDisplay" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>

        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <t t-set="khatriInfo2" t-value="getKhatriOrderInfo()"/>
            <t t-if="khatriInfo2 and khatriInfo2.totalSaved > 0">
                <div style="margin:8px 0; padding:8px 4px; border-top:2px solid #333;">
                    <div style="display:flex; justify-content:space-between; font-size:13px; color:#555;">
                        <span>Total MRP</span>
                        <span style="text-decoration:line-through;"><t t-esc="formatCurrency(khatriInfo2.totalOriginal)"/></span>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:14px; color:#27ae60; font-weight:700; margin-top:3px;">
                        <span>Total Saved</span>
                        <span><t t-esc="formatCurrency(khatriInfo2.totalSaved)"/></span>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:16px; color:#1a1a1a; font-weight:800; margin-top:4px; border-top:2px solid #333; padding-top:5px;">
                        <span>YOU PAY</span>
                        <span><t t-esc="formatCurrency(khatriInfo2.totalFinal)"/></span>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('after-footer')]" position="after">
            <t t-set="grgLogo" t-value="khatriReceiptLogo()"/>
            <t t-set="grgContact" t-value="khatriReceiptContact()"/>
            <div style="text-align:center; margin-top:14px; padding-top:12px; border-top:1px solid #e0e0e0;">
                <div style="font-size:10px; color:#555; margin-bottom:6px;">Powered by <b>Odoo</b></div>
                <img t-att-src="grgLogo" style="width:104px; max-width:50%; height:auto; display:block; margin:0 auto;" alt="goretailgo"/>
                <div style="font-size:11px; color:#555; margin-top:8px; letter-spacing:0.3px;">
                    <span style="font-weight:600; color:#10314f;">Contact</span>
                    <span style="color:#999;"> &#160;|&#160; </span>
                    <span t-esc="grgContact"/>
                </div>
                <div style="height:6px;"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-order-data')]" position="replace"/>
        <xpath expr="//div[hasclass('d-flex')][hasclass('gap-2')][div[hasclass('text-break')]]" position="replace"/>
    </t>


    <t t-name="point_of_sale.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">

        <xpath expr="//li[i[hasclass('fa-tag')]]" position="replace">
            <li t-if="vals.discount and khatriNotStepped(line)" class="price-per-unit">
                <i class="fa fa-tag pe-1"/><em><t t-esc="vals.discount"/>% </em> discount off on <t t-esc="vals.noDiscountPrice"/>
            </li>
        </xpath>

        <xpath expr="//div[hasclass('line-details')]" position="replace">
            <div class="line-details d-flex justify-content-between" t-att-class="{ 'align-items-center' : vals.isReceipt }">
                <t t-if="vals.isReceipt">
                    <span style="width:18px; font-size:11px; color:#555; align-self:center;">
                        <t t-esc="khatriLineIndex(line)"/>
                    </span>
                    <span style="flex:1; font-size:12px; align-self:center; padding-right:4px;">
                        <t t-set="catName" t-value="khatriCategoryName(line)"/>
                        <t t-if="catName"><t t-esc="catName"/> / </t>
                        <t t-esc="vals.name"/>
                        <t t-set="ldisc" t-value="khatriLineDiscountPct(line)"/>
                        <t t-if="ldisc"><span style="color:#c0392b; font-weight:700; font-size:11px;"> (<t t-esc="ldisc"/>% off)</span></t>
                    </span>
                    <span style="width:28px; text-align:center; font-size:12px; font-weight:700; align-self:center;">
                        <t t-esc="line.qty"/>
                    </span>
                    <span style="width:72px; text-align:right; font-size:11px; color:#888; align-self:center;">
                        <t t-if="khatriIsStepped(line)">
                            <span style="text-decoration:line-through;"><t t-esc="khatriLineMrp(line)"/></span>
                        </t>
                        <t t-if="khatriNotStepped(line)">
                            <t t-esc="khatriLineMrp(line)"/>
                        </t>
                    </span>
                    <span style="width:72px; text-align:right; font-size:12px; font-weight:600; align-self:center;">
                        <t t-out="vals.price"/>
                    </span>
                </t>
                <t t-else="">
                    <div class="product-name d-flex flex-grow-1 pe-2 text-truncate" t-att-class="{ 'align-items-center' : vals.isReceipt }">
                        <span class="qty d-inline-block fw-bolder" t-attf-class="{{ vals.isReceipt ? 'pe-2' : 'px-1' }}">
                            <t t-esc="vals.unitPart"/>
                            <small t-if="vals.decimalPart" t-out="vals.decimalPart" class="fw-normal" style="font-size: 85%;"/>
                        </span>
                        <span class="text-wrap d-inline">
                            <t t-esc="vals.name"/>
                            <br/>
                            <small t-if="vals.attributeString" t-out="vals.attributeString" class="attribute-line fst-italic"/>
                        </span>
                    </div>
                    <div t-if="vals.price" t-out="vals.price" class="product-price price fw-bolder"/>
                    <div t-if="vals.taxGroup" t-esc="vals.taxGroup" class="text-end" style="width: 2rem"/>
                </t>
            </div>
        </xpath>

    </t>

</templates>
